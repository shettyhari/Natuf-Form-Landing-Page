# Copy this file to .env and fill in the values.

# Port the Node server listens on (Nginx proxies to it in production).
PORT=3000

# Meta Pixel ID for PageView + Lead tracking. Leave empty to disable.
META_PIXEL_ID=

# Comma-separated origins allowed to POST leads when the frontend is hosted
# on a different domain (e.g. Vercel). Leave empty when the backend serves the page itself.
ALLOWED_ORIGINS=

# Folder with the frontend files. Defaults to ../frontend next to this backend.
FRONTEND_DIR=
